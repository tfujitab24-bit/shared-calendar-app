rules_version = '2';

// Only the two family accounts can read or change the calendar. Veron's
// account is also used by the private GitHub backup job.
// Cloud Functions use the Admin SDK and are not affected by these rules.
// UIDs, not emails, because this repo is public. Keep in sync with
// FAMILY_UIDS in public/index.html.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.uid in ['o8ndZ0sAdXZBKPvk6Nfsqis7aC13', '0sWTXa7lPZU61Cndm5ce9HF2Mtc2'];
    }

    match /households/{householdId} {
      allow read, write: if isFamily();
    }

    // Everything else (e.g. reminderState, written only by Cloud Functions)
    // is closed to apps.
  }
}
